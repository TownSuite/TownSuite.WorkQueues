<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
        <PackageId>TownSuite.WorkQueues.HealthChecks</PackageId>
        <Description>ASP.NET Core / Microsoft.Extensions health checks for TownSuite.WorkQueues message buses: polling-loop liveness plus per-queue thresholds for backlog age, dead-letters and undelivered faults.</Description>
        <PackageTags>workqueue;messagebus;healthchecks;health;monitoring</PackageTags>
        <PackageReleaseNotes>v26.1.0 — initial release. See CHANGELOG.md in the core package for full notes.</PackageReleaseNotes>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\TownSuite.WorkQueues\TownSuite.WorkQueues.csproj" />
    </ItemGroup>

</Project>
