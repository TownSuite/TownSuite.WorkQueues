<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net8.0;net10.0</TargetFrameworks>

        <PackageId>TownSuite.WorkQueues</PackageId>
        <Description>A work queue and message bus for .NET backed by PostgreSQL, SQL Server, Redis, or SQLite. Direct enqueue/dequeue API and a publish/subscribe message bus with at-least-once delivery, automatic retry, dead-lettering, scheduled delivery, and scoped consumers.</Description>
        <PackageTags>workqueue;messagebus;postgres;postgresql;sqlserver;redis;sqlite;background-jobs;queue;pubsub</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageReleaseNotes>v26.1.0 — message bus reliability: retry backoff, non-retryable exceptions, single-message replay, transactional publish, bounded concurrency, metrics and queue statistics, at-least-once Fault&lt;T&gt; delivery, and dead-letter listing. Schema changes require a backfill for manually managed databases. See included CHANGELOG.md for full notes.</PackageReleaseNotes>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\Readme.md"     Pack="true" PackagePath="\README.md" />
        <None Include="..\MIGRATING.md"  Pack="true" PackagePath="\MIGRATING.md" />
        <None Include="..\CHANGELOG.md"  Pack="true" PackagePath="\CHANGELOG.md" />
        <None Include="..\LICENSE"       Pack="true" PackagePath="\LICENSE" />
    </ItemGroup>

</Project>
