<Project>
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <!-- Shared NuGet package metadata for the packable backend libraries. -->
  <PropertyGroup>
    <AssemblyVersion>26.0.0</AssemblyVersion>
    <FileVersion>26.1.2</FileVersion>
    <Version>26.1.2</Version>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>
  <!-- On Jenkins, AUTOCONFIGURE_NUGET writes a NuGet config that restores through the local ProGet cache. -->
  <PropertyGroup Condition=" '$(NUGET_CONFIG_FILE)' != '' ">
    <RestoreConfigFile>$(NUGET_CONFIG_FILE)</RestoreConfigFile>
  </PropertyGroup>
</Project>