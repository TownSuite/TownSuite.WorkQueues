{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "WorkQueuesServer": {
    "Backend": "redis",
    "ConnectionString": "",
    "MaxMessageSize": 262144,
    "SubscriptionIdleTimeout": "00:05:00",
    "ClaimLease": "00:00:30",
    "MaxRetries": 5,
    "RetryDelay": "00:00:05",
    "RequireHttps": true,
    "TrustForwardedHeaders": true,
    "Jwt": {
      "Authority": "",
      "Issuer": "",
      "Audience": "workqueues",
      "SigningKey": "",
      "TopicClaimType": "scope"
    }
  }
}
