<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>false</IsPackable>
        <Description>HTTPS publish/subscribe API over the TownSuite.WorkQueues Postgres or Redis backend, for messaging across data centres.</Description>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
        <PackageReference Include="Microsoft.Data.SqlClient" />
        <PackageReference Include="Npgsql" />
        <PackageReference Include="StackExchange.Redis" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\TownSuite.WorkQueues\TownSuite.WorkQueues.csproj" />
        <ProjectReference Include="..\TownSuite.WorkQueues.Client\TownSuite.WorkQueues.Client.csproj" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="sql\topics.sql" />
        <EmbeddedResource Include="sql\topics.sqlserver.sql" />
        <InternalsVisibleTo Include="TownSuite.WorkQueues.Server.Testing" />
    </ItemGroup>

</Project>
